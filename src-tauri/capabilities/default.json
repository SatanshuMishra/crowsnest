{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the main window may call",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-always-on-top",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://wows-numbers.com/*"
        },
        {
          "url": "https://na.wows-numbers.com/*"
        },
        {
          "url": "https://asia.wows-numbers.com/*"
        },
        {
          "url": "https://wows-karma.com/*"
        },
        {
          "url": "https://na.wows-karma.com/*"
        },
        {
          "url": "https://asia.wows-karma.com/*"
        },
        {
          "url": "https://worldofwarships.com/*"
        },
        {
          "url": "https://worldofwarships.eu/*"
        },
        {
          "url": "https://worldofwarships.asia/*"
        },
        {
          "url": "https://developers.wargaming.net/*"
        },
        {
          "url": "https://wargaming.net/support/*"
        },
        {
          "url": "https://github.com/SatanshuMishra/crowsnest"
        }
      ]
    },
    "dialog:allow-open",
    "updater:default",
    "process:allow-restart"
  ]
}
